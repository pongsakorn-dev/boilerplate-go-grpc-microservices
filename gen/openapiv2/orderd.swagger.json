  "paths": {
    "/v1/orders": {
      "get": {
        "operationId": "OrderService_ListOrders",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1ListOrdersResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "page_size",
            "description": "Server clamps this to a documented maximum and echoes the size actually used.",
            "in": "query",
            "required": false,
            "type": "integer",
            "format": "int32"
          },
          {
            "name": "page_token",
            "description": "Opaque. Callers must treat it as a blob -- it encodes the keyset cursor, and its\ninternal shape is not part of the API contract.",
            "in": "query",
            "required": false,
            "type": "string"
          },
          {
            "name": "status",
            "description": "Typed filter fields only, deliberately not an AIP-160 expression language: a CEL-ish\nfilter parser is a large surface with no static query guarantees behind it.",
            "in": "query",
            "required": false,
            "type": "string",
            "enum": [
              "ORDER_STATUS_UNSPECIFIED",
              "ORDER_STATUS_PENDING",
              "ORDER_STATUS_CONFIRMED",
              "ORDER_STATUS_SHIPPED",
              "ORDER_STATUS_CANCELLED"
            ],
            "default": "ORDER_STATUS_UNSPECIFIED"
          },
          {
            "name": "customer_id",
            "in": "query",
            "required": false,
            "type": "string"
          }
        ],
