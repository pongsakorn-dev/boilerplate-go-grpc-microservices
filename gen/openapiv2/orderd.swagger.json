  "definitions": {
    "OrderServiceCancelOrderBody": {
      "type": "object",
      "properties": {
        "reason": {
          "type": "string"
        },
        "idempotency_key": {
          "type": "string",
          "description": "Reserved and validated, not honoured. Same status as CreateOrderRequest's -- the\nreasoning is written there once rather than twice."
        }
      }
    },
    "protobufAny": {
      "type": "object",
      "properties": {
        "@type": {
          "type": "string"
        }
      },
      "additionalProperties": {}
    },
    "rpcStatus": {
      "type": "object",
      "properties": {
        "code": {
          "type": "integer",
          "format": "int32"
        },
        "message": {
          "type": "string"
        },
        "details": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/protobufAny"
          }
        }
      }
    },
    "v1CancelOrderResponse": {
      "type": "object",
      "properties": {
        "order": {
          "$ref": "#/definitions/v1Order"
        }
      }
    },
    "v1CreateOrderRequest": {
      "type": "object",
      "properties": {
        "customer_id": {
          "type": "string"
        },
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/v1OrderItem"
          }
        },
        "idempotency_key": {
          "type": "string",
          "description": "Optional. ACCEPTED AND VALIDATED, BUT NOT YET HONOURED -- sending the same key twice\ncreates two orders. Do not build on it until you implement the mechanism.\n\nThe field is reserved here deliberately. Adding it later is wire-compatible but is a\nbreaking change for every client that then has to start sending it, and keeping the\nvalidation rule below means a fork that implements idempotency inherits well-formed\nkeys from day one rather than a mix of UUIDs and free text.\n\nWhat was here before claimed the opposite: that the RPC was replayable, yielding one\norder and two byte-identical responses, per a retry policy in a file it named\nservicecfg.json. No handler has ever read this field, and no such file has ever\nexisted. The real one, internal/platform/client/serviceconfig.go, says plainly that\nthis repository has no idempotency-key mechanism -- which is why retries are enabled\non reads and on no mutation at all.\n\nIdempotency was cut; docs/adr/0002-what-was-cut.md records it as the most\nconsequential of the cuts and names what implementing it costs.\n\nA wrong comment matters more here than almost anywhere else in the repository: protoc\ncopies it verbatim into gen/go/order/v1/order.pb.go and into the published OpenAPI\ndocument, so it reaches people who read a generated client and never open this file."
        }
      }
    },
    "v1CreateOrderResponse": {
      "type": "object",
      "properties": {
        "order": {
          "$ref": "#/definitions/v1Order"
        }
      }
    },
    "v1GetOrderResponse": {
      "type": "object",
      "properties": {
        "order": {
          "$ref": "#/definitions/v1Order"
        }
      }
    },
    "v1ListOrdersResponse": {
      "type": "object",
      "properties": {
        "orders": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/v1Order"
          }
        },
        "next_page_token": {
          "type": "string",
          "description": "Empty when there are no further pages."
        }
      }
    },
    "v1Money": {
      "type": "object",
      "properties": {
        "currency_code": {
          "type": "string",
          "description": "ISO-4217 three-letter currency code, e.g. \"USD\"."
        },
        "units": {
          "type": "string",
          "format": "int64",
          "description": "Whole units. For \"USD\", 1 unit is 1 dollar."
        },
        "nanos": {
          "type": "integer",
          "format": "int32",
          "description": "Fractional part in nanos (10^-9). Must carry the same sign as units."
        }
      },
      "description": "Money mirrors google.type.Money field-for-field (currency_code / units / nanos).\n\nIt is declared here rather than importing google/type/money.proto so the proto tree\nstays self-contained and codegen needs one fewer vendored file. The wire format is\nidentical to google.type.Money, so swapping to the canonical type later is not a\nbreaking change.\n\nMoney is NEVER a double. internal/order/money_test.go has an AST test asserting\nfloat64 appears nowhere in the money path -- floating point silently corrupts\nfinancial data in a way no integration test will catch."
    },
    "v1Order": {
      "type": "object",
      "properties": {
        "order_id": {
          "type": "string"
        },
        "tenant_id": {
          "type": "string",
          "description": "Populated by the server from the caller identity. This is an OUTPUT field.\n\nNo request message carries a tenant_id, so there is nothing for a client to override.\nThe isolation comes from the field being absent on the request side, not from a\nrejection rule. Cross-tenant invisibility is asserted by\ninternal/order/ordertest/contract.go, in \"an order in another tenant is\nindistinguishable from missing\"."
        },
        "customer_id": {
          "type": "string"
        },
        "status": {
          "$ref": "#/definitions/v1OrderStatus"
        },
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/v1OrderItem"
          }
        },
        "total": {
          "$ref": "#/definitions/v1Money"
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "updated_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "v1OrderItem": {
      "type": "object",
      "properties": {
        "sku": {
          "type": "string"
        },
        "quantity": {
          "type": "integer",
          "format": "int32"
        },
        "unit_price": {
          "$ref": "#/definitions/v1Money"
        }
      }
    },
    "v1OrderStatus": {
      "type": "string",
      "enum": [
        "ORDER_STATUS_UNSPECIFIED",
        "ORDER_STATUS_PENDING",
        "ORDER_STATUS_CONFIRMED",
        "ORDER_STATUS_SHIPPED",
        "ORDER_STATUS_CANCELLED"
      ],
      "default": "ORDER_STATUS_UNSPECIFIED"
    },
    "v1WatchOrdersResponse": {
      "type": "object",
      "properties": {
        "order": {
          "$ref": "#/definitions/v1Order"
        }
      }
    }
  }
