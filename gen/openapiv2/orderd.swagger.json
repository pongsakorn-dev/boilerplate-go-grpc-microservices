    "/v1/orders:watch": {
      "get": {
        "summary": "Server-streaming exists in the template on purpose: a stream is the only way to\nexercise the grpc.ServerStream context wrapper, mid-stream client cancellation, and\nthe graceful-drain path. All three are invisible to unary tests.",
        "operationId": "OrderService_WatchOrders",
        "responses": {
          "200": {
            "description": "A successful response.(streaming responses)",
            "schema": {
              "type": "object",
              "properties": {
                "result": {
                  "$ref": "#/definitions/v1WatchOrdersResponse"
                },
                "error": {
                  "$ref": "#/definitions/rpcStatus"
                }
              },
              "title": "Stream result of v1WatchOrdersResponse"
